@model IEnumerable<ServicioMedico.Models.VisitaMedica>

@{
    ViewData["Title"] = "Directorio de Alumnos";
}

<div class="container mt-5">
    <div class="row justify-content-center mb-4">
        <div class="col-md-8">
            <div class="input-group shadow-sm">
                <span class="input-group-text bg-white border-end-0">🔍</span>
                <input type="text" id="buscadorAlumno" class="form-control border-start-0" 
                       placeholder="Buscar por nombre o matrícula..." onkeyup="filtrarAlumnos()">
            </div>
        </div>
    </div>

    <div class="row g-3" id="contenedorTarjetas">
        @foreach (var alumno in Model)
        {
            <div class="col-12 tarjeta-alumno">
                <div class="card shadow-sm border-0 p-2">
                    <div class="card-body d-flex flex-column flex-md-row align-items-center gap-4">
                        <div class="flex-grow-1 text-center text-md-start">
                            <h5 class="card-title mb-1 fw-bold">
                                @alumno.NombreCompleto
                            </h5>

                            <p class="text-muted mb-1">
                                Matrícula:
                                <span class="dato-matricula fw-semibold">@alumno.Matricula</span>
                            </p>

                            <span class="badge bg-info text-dark">
                                @alumno.Carrera
                            </span>
                        </div>
                        <div class="flex-shrink-0">
                            <a class="btn btn-outline-primary rounded-pill px-4" asp-action="History" asp-route-id="@alumno.Matricula"> Ver Historial </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<script>
    function filtrarAlumnos() {
        let filtro = document.getElementById('buscadorAlumno').value.toLowerCase();
        let tarjetas = document.querySelectorAll('.tarjeta-alumno');
        tarjetas.forEach(t => {
            let texto = t.innerText.toLowerCase();
            t.style.display = texto.includes(filtro) ? "block" : "none";
        });
    }
</script>