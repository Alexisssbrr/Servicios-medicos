@model IEnumerable<ServicioMedico.Models.VisitaMedica>

@{
    ViewData["Title"] = "Historial Médico";
}

<div class="container mt-4">
    <div class="d-flex align-items-center mb-4">
        <a asp-action="Index" class="btn btn-outline-secondary me-3">← Volver</a>
        <h2 class="mb-0">Historial de: <span class="text-primary">@ViewData["Matricula"]</span></h2>
    </div>

    <div class="vstack gap-3">
        
        @if (!Model.Any())
        {
            <div class="alert alert-info">Este alumno no tiene visitas registradas.</div>
        }

        @foreach (var visita in Model)
        {
            <div class="card shadow-sm border-start border-primary border-4">
                <div class="card-body">
                    <div class="row align-items-center text-center text-md-start">
                        <div class="col-md-2">
                            <h5 class="mb-0 text-primary">@visita.FechaVisita.ToString("dd MMM")</h5>
                            <small class="text-muted">@visita.FechaVisita.ToString("yyyy")</small>
                            <small class="d-block text-muted">@visita.FechaVisita.ToString("HH:mm") hrs</small>
                        </div>
                        <div class="col-md-3">
                            <small class="d-block text-muted">Carrera</small>
                            @* <strong>@visita.Carrera</strong> *@
                        </div>
                        <div class="col-md-3">
                            <small class="d-block text-muted">Departamento</small>
                            <span class="badge bg-info text-dark">Enfermería</span>
                        </div>
                        <div class="col-md-4 text-md-end mt-3 mt-md-0">
                            <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#modal-@visita.Id">
                                Ver Diagnóstico
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <div class="modal fade" id="modal-@visita.Id" tabindex="-1" aria-hidden="true">
                <div class="modal-dialog modal-dialog-centered">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title">Detalle de la Visita</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                        </div>
                      <div class="modal-body">
    <p class="text-muted mb-3 small border-bottom pb-2">
        <i class="bi bi-calendar-event"></i> Atendido el: @visita.FechaVisita.ToString("f")
    </p>

    <h6 class="fw-bold text-secondary"><i class="bi bi-person-badge"></i> Información Física</h6>
    <div class="row mb-3">
        <div class="col-6">
            <small class="d-block text-muted">Talla</small>
            <span>@(visita.Talla > 0 ? visita.Talla + " cm" : "N/A")</span>
        </div>
        <div class="col-6">
            <small class="d-block text-muted">Peso</small>
            <span>@(visita.Peso > 0 ? visita.Peso + " kg" : "N/A")</span>
        </div>
    </div>

    <h6 class="fw-bold text-danger"><i class="bi bi-heart-pulse"></i> Signos Vitales</h6>
    <div class="row g-2 mb-3">
        <div class="col-4 border-end">
            <small class="d-block text-muted text-truncate">Temp.</small>
            <span class="fw-bold">@visita.Temperatura °C</span>
        </div>
        <div class="col-4 border-end text-center">
            <small class="d-block text-muted">Presión</small>
            <span class="fw-bold">@visita.PresionArterial</span>
        </div>
        <div class="col-4 text-end">
            <small class="d-block text-muted">Saturación</small>
            <span class="fw-bold">@visita.Saturacion %</span>
        </div>
        <div class="col-6 mt-2">
            <small class="d-block text-muted">Frec. Cardíaca</small>
            <span>@visita.FrecuenciaCardiaca lpm</span>
        </div>
        <div class="col-6 mt-2">
            <small class="d-block text-muted">Frec. Respiratoria</small>
            <span>@visita.FrecuenciaRespiratoria rpm</span>
        </div>
    </div>

    <h6 class="fw-bold text-warning"><i class="bi bi-exclamation-triangle"></i> Antecedentes</h6>
    <div class="mb-3">
        <small class="d-block text-muted">Alergias:</small>
        <span class="@(visita.TieneAlergias ? "text-danger fw-bold" : "text-success")">
            @(visita.TieneAlergias ? "Sí presenta" : "Ninguna")
        </span>
        
        <small class="d-block text-muted mt-2">Enfermedades Crónicas:</small>
        <span class="text-dark">@(string.IsNullOrEmpty(visita.EnfermedadesCronicas) ? "Ninguna reportada" : visita.EnfermedadesCronicas)</span>
    </div>

    <h6 class="fw-bold text-primary"><i class="bi bi-clipboard2-pulse"></i> Diagnóstico:</h6>
    <div class="p-3 bg-light border-start border-primary border-4 rounded">
        "@visita.Diagnostico"
    </div>
</div>
                    </div>
                </div>
            </div>
        }

    </div>
</div>