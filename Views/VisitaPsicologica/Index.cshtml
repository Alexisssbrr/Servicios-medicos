@model IEnumerable<ServicioMedico.Models.VisitaPsicologica>

@{
    ViewData["Title"] = "Directorio de Psicología";
}

<div class="container mt-5">
    <h2 class="text-center mb-4" style="color: #8e44ad;">Directorio de Pacientes - Psicología</h2>

    <div class="row justify-content-center mb-4">
        <div class="col-md-8">
            <div class="input-group shadow-sm">
                <span class="input-group-text bg-white border-end-0">🔍</span>
                <input type="text" id="buscadorPsicologia" class="form-control border-start-0"
                       placeholder="Buscar por nombre o matrícula en psicología..." onkeyup="filtrarPsicologia()">
            </div>
        </div>
    </div>

    <div class="row g-3" id="contenedorTarjetas">
        @if (!Model.Any())
        {
            <div class="col-12 text-center">
                <p class="text-muted">No hay registros de visitas psicológicas aún.</p>
            </div>
        }

        @foreach (var alumno in Model)
        {
            <div class="col-12 tarjeta-psicologia">
                <div class="card shadow-sm border-0 p-2">
                    <div class="card-body d-flex flex-column flex-md-row align-items-center gap-4">
                        <div class="flex-grow-1 text-center text-md-start">
                            <h5 class="card-title mb-1 fw-bold">@alumno.NombreCompleto</h5>
                            <p class="text-muted mb-1">
                                Matrícula: <span class="fw-semibold">@alumno.Matricula</span>
                            </p>
                            <span class="badge" style="background-color: #8e44ad;">
                                @alumno.Carrera
                            </span>
                        </div>
                        <div class="flex-shrink-0">
                            <a class="btn btn-outline-purple rounded-pill px-4"
                               style="border-color: #8e44ad; color: #8e44ad;"
                               asp-action="History" asp-route-id="@alumno.Matricula">
                                Ver Sesiones
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<script>
    function filtrarPsicologia() {
        let filtro = document.getElementById('buscadorPsicologia').value.toLowerCase();
        let tarjetas = document.querySelectorAll('.tarjeta-psicologia');

        tarjetas.forEach(t => {
            let texto = t.innerText.toLowerCase();
            if (texto.includes(filtro)) {
                t.style.setProperty("display", "block", "important");
            } else {
                t.style.setProperty("display", "none", "important");
            }
        });
    }
</script>

<style>
    /* Efecto hover para las tarjetas de psicología */
    .tarjeta-psicologia .card {
        transition: transform 0.2s;
    }

        .tarjeta-psicologia .card:hover {
            transform: scale(1.01);
            border-left: 5px solid #8e44ad !important;
        }

    .btn-outline-purple:hover {
        background-color: #8e44ad;
        color: white !important;
    }
</style>