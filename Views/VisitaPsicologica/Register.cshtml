@model ServicioMedico.Models.VisitaPsicologica

<div class="container mt-5">
    <div class="card shadow-sm" style="max-width: 800px; margin: auto; border-top: 5px solid #8e44ad;">
        <div class="card-body p-4">
            <h2 class="text-center mb-4" style="color: #8e44ad;">Registro de Consulta Psicológica</h2>

            <form asp-action="Register" method="post">
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-bold">Matrícula</label>
                        <input asp-for="Matricula" class="form-control" id="Matricula" placeholder="Ej. 2216109093" />
                        <span asp-validation-for="Matricula" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-bold">Nombre Completo</label>
                        <input asp-for="NombreCompleto" class="form-control" id="NombreCompleto" readonly />
                    </div>

                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-bold">Carrera</label>
                        <input asp-for="Carrera" class="form-control" id="Carrera" readonly />
                    </div>


                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-bold">Edad</label>
                        <input asp-for="Edad" class="form-control" type="number" />
                    </div>

                    <div class="col-12 mb-3">
                        <label class="form-label fw-bold">Motivo de la Consulta</label>
                        <textarea asp-for="MotivoConsulta" class="form-control" rows="3"></textarea>
                    </div>

                    <div class="col-md-6 mb-3">
                        <div class="form-check form-switch mt-4">
                            <input asp-for="TerapiaPrevia" class="form-check-input" type="checkbox" id="checkTerapia">
                            <label class="form-check-label" for="checkTerapia">¿Ha tenido terapia previa?</label>
                        </div>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-bold">Motivo de Terapia Anterior</label>
                        <input asp-for="MotivoConsultaPrevia" class="form-control" placeholder="Opcional" />
                    </div>

                    <div class="col-12 mb-3">
                        <label class="form-label fw-bold">Medicación Psiquiátrica Actual</label>
                        <input asp-for="MedicacionPsiquiatrica" class="form-control" placeholder="Ninguna / Cuál..." />
                    </div>
                </div>

                <div class="text-center mt-4">
                    <button type="submit" class="btn btn-lg px-5 text-white" style="background-color: #8e44ad;">
                        Guardar Sesión
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
<script>
    document.addEventListener("DOMContentLoaded", function () {
        const inputMatricula = document.getElementById('Matricula');

        inputMatricula.addEventListener('blur', function () {
            const matricula = this.value.trim();

            if (matricula) {
                fetch(`/VisitaPsicologica/ObtenerDatosAlumno?matricula=${matricula}`)
                    .then(response => {
                        if (!response.ok) {
                            throw new Error("No encontrado");
                        }
                        return response.json();
                    })
                    .then(data => {
                        document.getElementById('NombreCompleto').value = data.nombreCompleto;
                        document.getElementById('Carrera').value = data.carrera;

                        // Si quieres calcular edad automáticamente:
                        if (data.fechaNacimiento) {
                            const fecha = new Date(data.fechaNacimiento);
                            const hoy = new Date();
                            let edad = hoy.getFullYear() - fecha.getFullYear();
                            const m = hoy.getMonth() - fecha.getMonth();

                            if (m < 0 || (m === 0 && hoy.getDate() < fecha.getDate())) {
                                edad--;
                            }

                            document.querySelector('[name="Edad"]').value = edad;
                        }
                    })
                    .catch(error => {
                        console.log("Alumno no encontrado o error:", error);
                    });
            }
        });
    });
</script>

